// Sortech Wardrobe v2 — database schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum Style {
  FORMAL
  INFORMAL
}

enum Category {
  TSHIRT
  SHIRT
  JEANS
  TROUSER
  PANTS
  SHOES
  SANDALS
  JACKET
  KURTA
  SHALWAR_KAMEEZ
  WATCH
  CAP
  ACCESSORY
  OTHER
}

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  passwordHash  String
  role          Role           @default(USER)
  createdAt     DateTime       @default(now())
  clothingItems ClothingItem[]
  outfits       Outfit[]
  wearLogs      WearLog[]
  // outfits shared TO this user
  sharedWithMe  OutfitShare[]  @relation("SharedWithUser")
  // outfits this user shared
  sharedByMe    OutfitShare[]  @relation("SharedByUser")

  @@map("users")
}

model ClothingItem {
  id         String      @id @default(cuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  category   Category
  style      Style
  imageUrl   String
  imageId    String?
  costCents  Int?
  currency   String      @default("PKR")
  createdAt  DateTime    @default(now())
  outfitItems OutfitItem[]

  @@index([userId])
  @@map("clothing_items")
}

model Outfit {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  createdAt   DateTime      @default(now())
  items       OutfitItem[]
  wearLogs    WearLog[]
  shares      OutfitShare[]

  @@index([userId])
  @@map("outfits")
}

model OutfitItem {
  id             String       @id @default(cuid())
  outfitId       String
  outfit         Outfit       @relation(fields: [outfitId], references: [id], onDelete: Cascade)
  clothingItemId String
  clothingItem   ClothingItem @relation(fields: [clothingItemId], references: [id], onDelete: Cascade)

  @@unique([outfitId, clothingItemId])
  @@map("outfit_items")
}

// Tracks every time a user confirms wearing an outfit
model WearLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  outfitId  String
  outfit    Outfit   @relation(fields: [outfitId], references: [id], onDelete: Cascade)
  wornAt    DateTime @default(now())
  occasion  String?  // e.g. "Wedding", "Office", "Casual outing"
  notes     String?

  @@index([userId])
  @@index([outfitId])
  @@map("wear_logs")
}

// In-app outfit sharing between registered users (with email notification)
model OutfitShare {
  id          String   @id @default(cuid())
  outfitId    String
  outfit      Outfit   @relation(fields: [outfitId], references: [id], onDelete: Cascade)
  fromUserId  String
  fromUser    User     @relation("SharedByUser", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId    String
  toUser      User     @relation("SharedWithUser", fields: [toUserId], references: [id], onDelete: Cascade)
  message     String?
  seenAt      DateTime?
  createdAt   DateTime @default(now())

  @@unique([outfitId, toUserId])
  @@index([toUserId])
  @@map("outfit_shares")
}
